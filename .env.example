# Copy this file to .env for local development. Do not commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
SHOP_NAME=Your Local Fashion Store
# Local development:
DATABASE_URL=sqlite:///shop.db
COOKIE_SECURE=false
# Production: set DATABASE_URL to your hosted PostgreSQL connection string.
# Set CLOUDINARY_URL to your Cloudinary product environment URL for durable
# image storage. Without it, images are saved locally and may be lost on hosts
# with ephemeral filesystems.
# COOKIE_SECURE=true
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
